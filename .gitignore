assets/zips/
web/assets/zips/

# ---- 系统垃圾 ----
.DS_Store
Thumbs.db
*.swp
hub/backups/

# ---- 手动状态备份（运行时产物，不进库）----
hub/*.bak
hub/*-bak
hub/*.manual-bak
